# Port du serveur HTTP
PORT=5000

# Environnement d'exécution (development | production | test)
NODE_ENV=development

# Chaîne de connexion MongoDB Atlas
MONGO_URI=mongodb://localhost:27017/votelify

# Clé secrète de signature des jetons d'administration JWT
JWT_SECRET=votelify_super_secret_jwt_key_at_least_32_characters_long

# Mot de passe secret pour initialiser le premier compte administrateur
AD_PW=AdminVoteLiFy2026!SecureKey

# Origine frontend autorisée pour les requêtes CORS
CLIENT_URL=http://localhost:5173

# Durée de validité de la session administrateur en heures
ADMIN_SESSION_HOURS=12
